{
  "name": "nass",
  "version": "0.1.0",
  "description": "Not A Style System. A small CSS foundation, themes, and reusable primitives extracted from JustBookmarks.",
  "license": "MIT",
  "type": "module",
  "style": "./src/entries/index.css",
  "files": [
    "src",
    "docs",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/entries/index.css",
    "./index.css": "./src/entries/index.css",
    "./foundation.css": "./src/entries/foundation.css",
    "./primitives.css": "./src/entries/primitives.css",
    "./icons.css": "./src/entries/icons.css",
    "./themes/light.css": "./src/themes/light.css",
    "./themes/dark.css": "./src/themes/dark.css"
  },
  "scripts": {
    "demo:build": "node ./scripts/stage-demo-site.mjs",
    "demo": "node ./scripts/stage-demo-site.mjs && python3 -m http.server 4174 -d .site"
  },
  "keywords": [
    "css",
    "design-system",
    "styles",
    "tokens",
    "themes"
  ]
}
